# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg2://naval_user:naval_pass@localhost:5432/naval_ai

# Background job queue — video processing runs async via an RQ worker
# (see backend/worker.py). Run `redis-server` locally, or use the
# `redis` service in docker-compose.yml.
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real secret for any non-local deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
REPORT_DIR=./reports

# Model
YOLO_WEIGHTS_PATH=../models/weights/best.pt
YOLO_DEVICE=cpu          # cpu | cuda | mps | 0,1 (GPU indices)
YOLO_CONF_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45

# Video processing
TRACKER_TYPE=bytetrack   # bytetrack | botsort
MAX_VIDEO_DURATION_SECONDS=300

# CORS
ALLOWED_ORIGINS=http://localhost:3000
